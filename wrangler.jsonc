// Cloudflare Workers static assets: serves the Vite build in ./dist (pnpm build).
{
  "name": "currency-ruler",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // The app's address. Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "fx-ruler.subtl.ink", "custom_domain": true }],
  // Keep the old address too: phones that installed the app from it still get updates.
  // (With a custom domain, wrangler turns workers.dev off unless it's asked for.)
  "workers_dev": true
}
